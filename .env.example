# Mizrahi Compliance Platform - Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# Environment
# ===========================================
ENVIRONMENT=development
DEBUG=true

# ===========================================
# Database
# ===========================================
# Development: SQLite
DATABASE_URL=sqlite:///./dev.db

# Production: PostgreSQL (Railway will auto-inject)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ===========================================
# Apify (Web Scraping)
# ===========================================
APIFY_API_TOKEN=your_apify_token_here

# ===========================================
# Email (Resend)
# ===========================================
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=notifications@82labs.io

# ===========================================
# Email (Gmail SMTP - Development fallback)
# ===========================================
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ===========================================
# Slack Notifications (Optional)
# ===========================================
SLACK_WEBHOOK_URL=

# ===========================================
# TASE API (Optional - for price checks)
# ===========================================
TASE_API_KEY=

# ===========================================
# Server Configuration
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ===========================================
# CORS (comma-separated origins)
# ===========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# Monitoring (Optional)
# ===========================================
SENTRY_DSN=
