# Mizrahi Compliance Platform - Environment Variables
# Copy to deploy/digitalocean/.env and fill in your values
# DO NOT commit the .env file to git!

# Apify API Token (required for data fetching from TASE Maya)
# Get from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# Resend API Key (required for email delivery)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email sender address (must be verified in Resend dashboard)
FROM_EMAIL=noreply@notifications.82labs.io

# TASE Data Hub API Key (optional, for Hook 4 index data)
# Get from: https://info.tase.co.il/en/datahub
TASE_API_KEY=your_tase_api_key_here
