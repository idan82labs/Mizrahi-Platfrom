    {
      "parameters": {
        "jsCode": "// Get the XLSX binary data\nconst fundsListBinary = $('Code to XLSX File').first().binary.xlsx;\n\n// Get CSV data as text strings from json.data\nconst currentReportText = $('Latest Month Downloader').first().json.data;\nconst previousReportText = $('Previous Month Downloader').first().json.data;\n\n// Get form field values\nconst formFields = $('Start').first().json._firstItem;\nconst managerName = $('Start').first().json.fundName;\nconst trusteeName = '';\nconst reportMonth = $('Funds Manager Actor - Get DB').first().json.downloadedFiles?.[0]?.reportName || '';\n\n// Build multipart form data manually\nconst boundary = '----FormBoundary' + Date.now();\n\nfunction buildFilePart(fieldName, fileName, mimeType) {\n  return `--${boundary}\\r\\nContent-Disposition: form-data; name=\"${fieldName}\"; filename=\"${fileName}\"\\r\\nContent-Type: ${mimeType}\\r\\n\\r\\n`;\n}\n\nfunction buildTextPart(fieldName, value) {\n  return `--${boundary}\\r\\nContent-Disposition: form-data; name=\"${fieldName}\"\\r\\n\\r\\n${value}\\r\\n`;\n}\n\n// Convert XLSX from base64 to buffer\nconst fundsListData = Buffer.from(fundsListBinary.data, 'base64');\n\n// Convert CSV text to buffers\nconst currentReportData = Buffer.from(currentReportText, 'utf-8');\nconst previousReportData = Buffer.from(previousReportText, 'utf-8');\n\n// Build the multipart body\nconst parts = [];\n\n// XLSX file part\nparts.push(Buffer.from(buildFilePart('funds_list', 'funds_list.xlsx', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')));\nparts.push(fundsListData);\nparts.push(Buffer.from('\\r\\n'));\n\n// CSV file parts (from text)\nparts.push(Buffer.from(buildFilePart('current_report', 'current_report.csv', 'text/csv')));\nparts.push(currentReportData);\nparts.push(Buffer.from('\\r\\n'));\n\nparts.push(Buffer.from(buildFilePart('previous_report', 'previous_report.csv', 'text/csv')));\nparts.push(previousReportData);\nparts.push(Buffer.from('\\r\\n'));\n\n// Text parts\nparts.push(Buffer.from(buildTextPart('manager_name', managerName)));\nparts.push(Buffer.from(buildTextPart('trustee_name', trusteeName)));\nparts.push(Buffer.from(buildTextPart('report_month', reportMonth)));\n\n// Closing boundary\nparts.push(Buffer.from(`--${boundary}--\\r\\n`));\n\n// Combine all parts\nconst body = Buffer.concat(parts);\n\n// Send request\nconst response = await this.helpers.httpRequest({\n  method: 'POST',\n  url: 'http://209.38.226.220/process',\n  headers: {\n    'Content-Type': `multipart/form-data; boundary=${boundary}`\n  },\n  body: body,\n  returnFullResponse: false,\n  json: true\n});\n\n// Return with binary for email\nreturn [{\n  json: {\n    status: response.status,\n    job_id: response.job_id,\n    fileName: response.fileName || 'fund_report.xlsx',\n    managerName: managerName,\n    reportMonth: reportMonth\n  },\n  binary: {\n    data: {\n      data: response.fileBase64,\n      mimeType: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',\n      fileName: response.fileName || 'fund_report.xlsx'\n    }\n  }\n}];"
      },
