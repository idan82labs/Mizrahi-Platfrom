    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html dir=\"rtl\" lang=\"he\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>דוח בקרת איכות נתונים</title>\n</head>\n<body style=\"margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f6f8; direction: rtl; line-height: 1.7;\">\n    \n    <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background-color: #f4f6f8; padding: 40px 20px;\">\n        <tr>\n            <td align=\"center\">\n                \n                <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" style=\"max-width: 600px; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06); overflow: hidden;\">\n                    \n                    <!-- Header -->\n                    <tr>\n                        <td style=\"background-color: #ffffff; padding: 30px 40px; border-bottom: 1px solid #eef1f4; text-align: center;\">\n                            <img src=\"https://storage.bhol.co.il/articles/35167_tumb_700X500.png\" alt=\"מזרחי טפחות\" style=\"max-height: 100px; max-width: 420px;\">\n                        </td>\n                    </tr>\n                    \n                    <!-- Status Banner -->\n                    <tr>\n                        <td style=\"background: linear-gradient(135deg, #10B981 0%, #059669 100%); padding: 45px 40px; text-align: center;\">\n                            <div style=\"width: 70px; height: 70px; background-color: rgba(255,255,255,0.2); border-radius: 50%; margin: 0 auto 20px; line-height: 70px;\">\n                                <span style=\"font-size: 32px; color: white;\">✓</span>\n                            </div>\n                            <h1 style=\"color: #ffffff; margin: 0 0 8px 0; font-size: 24px; font-weight: 600;\">דוח בקרת איכות נתונים</h1>\n                            <p style=\"color: rgba(255,255,255,0.9); margin: 0; font-size: 15px; font-weight: 400;\">הדוח נוצר בהצלחה</p>\n                        </td>\n                    </tr>\n                    \n                    <!-- Main Content -->\n                    <tr>\n                        <td style=\"padding: 40px;\">\n                            \n                            <!-- Info Card -->\n                            <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background-color: #f8fafc; border-radius: 8px; border-right: 4px solid #10B981;\">\n                                <tr>\n                                    <td style=\"padding: 25px;\">\n                                        <h2 style=\"color: #1e293b; margin: 0 0 15px 0; font-size: 17px; font-weight: 600;\">פרטי הדוח</h2>\n                                        \n                                        <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\">\n                                            <tr>\n                                                <td style=\"padding: 8px 0; color: #64748b; font-size: 14px; width: 120px;\">מנהל קרן:</td>\n                                                <td style=\"padding: 8px 0; color: #1e293b; font-size: 14px; font-weight: 500;\">{{ $('Start').item.json.fundName }}</td>\n                                            </tr>\n                                            <tr>\n                                                <td style=\"padding: 8px 0; color: #64748b; font-size: 14px;\">שם הדוח:</td>\n                                                <td style=\"padding: 8px 0; color: #1e293b; font-size: 14px; font-weight: 500;\">{{ $('Funds Manager Actor - Get DB').item.json.downloadedFiles[0].reportName }}</td>\n                                            </tr>\n                                            <tr>\n                                                <td style=\"padding: 8px 0; color: #64748b; font-size: 14px;\">תאריך יצירה:</td>\n                                                <td style=\"padding: 8px 0; color: #1e293b; font-size: 14px; font-weight: 500;\">{{ $now.setZone('Asia/Jerusalem').toFormat('dd/MM/yyyy') }}</td>\n                                            </tr>\n                                            <tr>\n                                                <td style=\"padding: 8px 0; color: #64748b; font-size: 14px;\">שעת יצירה:</td>\n                                                <td style=\"padding: 8px 0; color: #1e293b; font-size: 14px; font-weight: 500;\">{{ $now.setZone('Asia/Jerusalem').toFormat('HH:mm') }}</td>\n                                            </tr>\n                                        </table>\n                                    </td>\n                                </tr>\n                            </table>\n                            \n                            <!-- Attachment Notice -->\n                            <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-top: 25px;\">\n                                <tr>\n                                    <td style=\"background-color: #eff6ff; border-radius: 8px; padding: 18px 20px; text-align: center;\">\n                                        <span style=\"color: #3b82f6; font-size: 18px; margin-left: 8px;\">📎</span>\n                                        <span style=\"color: #1e40af; font-size: 14px;\">הדוח מצורף למייל זה כקובץ Excel</span>\n                                    </td>\n                                </tr>\n                            </table>\n                            \n                        </td>\n                    </tr>\n                    \n                    <!-- Footer -->\n                    <tr>\n                        <td style=\"background-color: #f8fafc; padding: 20px 40px; text-align: center; border-top: 1px solid #e2e8f0;\">\n                            <p style=\"margin: 0; color: #94a3b8; font-size: 12px;\">\n                                פותח על ידי <a href=\"https://82labs.com\" target=\"_blank\" style=\"color: #64748b; text-decoration: none; font-weight: 600;\">82Labs</a>\n                            </p>\n                        </td>\n                    </tr>\n                    \n                </table>\n                \n            </td>\n        </tr>\n    </table>\n    \n</body>\n</html>"
