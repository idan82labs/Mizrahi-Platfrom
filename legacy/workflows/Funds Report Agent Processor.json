      "parameters": {
        "jsCode": "const b64 = $input.first().json.fileBase64;\n\nif (!b64) {\n  throw new Error('missing fileBase64 on input');\n}\n\n// לוקחים את הפריט הראשון\nconst out = $input.first();\n\n// מוסיפים לו את ה-binary\nout.binary = out.binary || {};\nout.binary.xlsx = {\n  data: Buffer.from(b64, 'base64'),\n  fileName: 'mutual-funds.xlsx',\n  mimeType: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',\n};\n\n// ב-Code node חייבים להחזיר מערך\nreturn [out];\n"
      },
